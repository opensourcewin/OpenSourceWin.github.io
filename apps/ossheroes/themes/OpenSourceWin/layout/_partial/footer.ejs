<script>
window.onload = function () {
    const navWrap = document.getElementById('navWrap');
    // 使用主题变量，保持与暗黑导航一致（不再硬编码旧亮色体系色值）
    const navBg = getComputedStyle(document.documentElement).getPropertyValue('--osw-card').trim() || 'var(--osw-card)';
    window.addEventListener('scroll', function() {
        if (window.scrollY > 100) {
            navWrap.style.backgroundColor = navBg;
        } else {
            navWrap.style.backgroundColor = 'transparent';
        }
    })
}
</script>
