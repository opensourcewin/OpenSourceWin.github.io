---
import { getCollection } from 'astro:content';
import HeroPage from '../../../components/pages/HeroPage.astro';

export async function getStaticPaths() {
  const heroes = await getCollection('heroes');
  return heroes.map((entry) => ({
    params: { login: String(entry.data.slug) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<HeroPage locale="zh-CN" entry={entry} />
