---
import { t, type Locale } from '@opensource-win/ui';

interface Props {
  locale: Locale;
  /** 历年在榜名次（按年份降序）：[{ year, ranking }] */
  years: { year: number; ranking: number }[];
}

const { locale, years } = Astro.props;
---

{/* 历年排名徽章：[2026] RANK #12 —— 终端风 pill，直角 + 暗绿边框 + 霓虹绿文字 */}
{years.map((item) => (
  <span class="rank-badge">[{item.year}] {t(locale, '排名', 'RANK')} #{item.ranking}</span>
))}
