---
import { HEROES_BASE as BASE } from '../lib/site';
import { getPastYears } from '../lib/ranking';

const pastYears = getPastYears();
---

<!-- 导航 -->
<nav class="navbar" id="navWrap">
  <div class="container navbar-inner">
    <a class="navbar-brand" href={`${BASE}/`} data-i18n-zh="中国开源码力榜" data-i18n-en="China Open Source HeroRank">中国开源码力榜</a>
    <button class="navbar-toggler" type="button" aria-controls="navbarMenu" aria-expanded="false" aria-label="Toggle navigation">
      <svg viewBox="0 0 30 30" fill="none" aria-hidden="true">
        <path stroke="currentColor" stroke-linecap="round" stroke-miterlimit="10" stroke-width="2" d="M4 7h22M4 15h22M4 23h22"></path>
      </svg>
    </button>
    <div class="navbar-menu" id="navbarMenu">
      <ul class="navbar-nav">
        <li class="nav-item">
          <a href={`${BASE}/#ranking`} class="nav-link" data-i18n-zh="榜单背景" data-i18n-en="Background">榜单背景</a>
        </li>
        <li class="nav-item">
          <a href={`${BASE}/#standard`} class="nav-link" data-i18n-zh="评选标准" data-i18n-en="Criteria">评选标准</a>
        </li>
        <li class="nav-item">
          <a href={`${BASE}/#detail`} class="nav-link" data-i18n-zh="榜单详情" data-i18n-en="Rankings">榜单详情</a>
        </li>
        <li class="nav-item">
          <a href={`${BASE}/#partner`} class="nav-link" data-i18n-zh="合作伙伴" data-i18n-en="Partners">合作伙伴</a>
        </li>
        <li class="nav-item">
          <a href="https://github.com/opensourcewin" target="_blank" class="nav-link">GitHub</a>
        </li>
        <li class="nav-item nav-dropdown">
          <button type="button" class="nav-link dropdown-toggle" aria-expanded="false" data-i18n-zh="往年榜单" data-i18n-en="Past Rankings">往年榜单</button>
          <ul class="dropdown-menu">
            {pastYears.map((year) => (
              <li><a class="dropdown-item" href={`${BASE}/ranking-${year}/`}>{year}</a></li>
            ))}
          </ul>
        </li>
        <li class="nav-item">
          <a href="https://opensource.win/" class="nav-link" data-i18n-zh="回到官网" data-i18n-en="Main Site">回到官网</a>
        </li>
        <!-- 语言切换：中 / EN，与官网共用 localStorage key osw-language -->
        <li class="nav-item lang-switch" aria-label="Language / 语言">
          <button type="button" class="lang-btn" data-lang-switch="zh" onclick="window.OSW_I18N && OSW_I18N.set('zh')">中</button><span class="lang-sep" aria-hidden="true">/</span><button type="button" class="lang-btn" data-lang-switch="en" onclick="window.OSW_I18N && OSW_I18N.set('en')">EN</button>
        </li>
      </ul>
    </div>
  </div>
</nav>
