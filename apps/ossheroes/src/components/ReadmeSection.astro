---
import { t, type Locale } from '@opensource-win/ui';
import ReadmeLoader from './ReadmeLoader';

interface Props {
  locale: Locale;
  login: string;
}

const { locale, login } = Astro.props;
---

{/* GitHub Profile README：客户端拉取 <login>/<login> 仓库 README，失败整体隐藏 */}
<div class="detail-term detail-readme" id="detailReadme" data-login={login} hidden>
  <div class="detail-term-bar">
    <span class="detail-term-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="detail-term-title">~/profile/README.md</span>
  </div>
  <div class="detail-term-body">
    <div class="detail-term-cmd"><span class="detail-term-prompt" aria-hidden="true">$</span> cat ~/profile/README.md</div>
    <ReadmeLoader
      login={login}
      shellId="detailReadme"
      truncatedNote={t(locale, '\n\n… [内容过长，已截断]', '\n\n… [truncated]')}
      client:idle
    />
    <div class="detail-readme-src">
      <span class="detail-term-out" aria-hidden="true">&gt;</span>
      <span>{t(locale, '来源', 'source')}</span>
      <span class="detail-term-sep" aria-hidden="true">::</span>
      <a href={`https://github.com/${login}/${login}`} target="_blank" rel="noopener">github.com/{login}/{login}</a>
    </div>
  </div>
</div>
