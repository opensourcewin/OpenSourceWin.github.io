<!-- 头部（banner 大图已移除，图片文件仍保留在 source/img/） -->
<div class="header header-detail">
    <%- partial('menu') %>
</div>
<!-- 详情 -->
<div class="container pt-5 detail-content">
    <div class="row justify-content-center">
        <div class="col-sm-12 col-md-8">
            <!-- 终端风 profile 卡片：$ ./whois <login> -->
            <div class="detail-term">
                <div class="detail-term-bar">
                    <span class="detail-term-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                    <span class="detail-term-title">opensource@win: ~</span>
                </div>
                <div class="detail-term-body">
                    <div class="detail-term-cmd"><span class="detail-term-prompt" aria-hidden="true">$</span> ./whois <%- item.slug %></div>
                    <%
                        const years = site.data.rankingList?.sort((a,b)=>b.year - a.year).flatMap(({ year, annualRanking }) =>
                          annualRanking
                            .filter(({ login }) => login == item.slug)
                            .map(({ ranking }) => ({ year, ranking }))
                        );
                    %>
                    <div class="detail-term-result">
                        <%- partial('avatar', {className: 'detail-avatar', item: item}) %>
                        <div class="detail-term-info">
                            <div class="detail-term-line">
                                <span class="detail-term-out" aria-hidden="true">&gt;</span>
                                <span class="detail-term-key" data-i18n-zh="名称" data-i18n-en="name">名称</span>
                                <span class="detail-term-sep" aria-hidden="true">::</span>
                                <span class="detail-term-name"><%- item.name ? item.name : item.slug %></span>
                            </div>
                            <div class="detail-term-line">
                                <span class="detail-term-out" aria-hidden="true">&gt;</span>
                                <span class="detail-term-key" data-i18n-zh="简介" data-i18n-en="bio">简介</span>
                                <span class="detail-term-sep" aria-hidden="true">::</span>
                                <span class="text-secondary"><%- item.description %></span>
                            </div>
                            <div class="detail-term-line">
                                <span class="detail-term-out" aria-hidden="true">&gt;</span>
                                <span class="detail-term-key">github</span>
                                <span class="detail-term-sep" aria-hidden="true">::</span>
                                <%- link_to('https://github.com/' + item.slug, '@' + item.slug, {external: true}) %>
                            </div>
                            <% if(years.length) { %>
                                <div class="detail-ranks">
                                    <%- partial('_partial/ranking', {years: years}) %>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>

            <div class="contribute mt-4 mt-sm-1">
                <%- item.content %>
                <%- partial('osgraph', {slug: item.slug}) %>
            </div>
        </div>
    </div>
</div>

<%- partial('_partial/copyRight') %>
