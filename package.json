{
  "name": "opensource-win",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter www dev",
    "build": "pnpm --filter www build && pnpm --filter ossheroes build",
    "build:www": "pnpm --filter www build",
    "build:ossheroes": "pnpm --filter ossheroes build",
    "clean": "pnpm -r exec rm -rf dist node_modules/.cache .astro"
  },
  "devDependencies": {}
}
