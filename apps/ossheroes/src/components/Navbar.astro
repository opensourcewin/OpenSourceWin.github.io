---
import { LOCALES, localePath, localeUrl, t, type Locale } from '@opensource-win/ui';
import { HEROES_BASE as BASE, SITE_URL } from '../lib/site';
import { getPastYears } from '../lib/ranking';

interface Props {
  locale: Locale;
  /** locale 中立的规范路径（如 '/heroes/'、'/hero/<login>/'），供语言切换跳转 */
  path: string;
}

const { locale, path } = Astro.props;
const pastYears = getPastYears();

/** 当前语言的榜单首页路径（锚点链接拼接用） */
const home = localePath(locale, `${BASE}/`);
const mainSite = localeUrl(SITE_URL, locale, '/');

const LANG_LABELS: Record<Locale, string> = { en: 'EN', 'zh-CN': '简', 'zh-TW': '繁' };
---

{/* 导航 */}
<nav class="navbar" id="navWrap">
  <div class="container navbar-inner">
    <a class="navbar-brand" href={home}>{t(locale, '中国开源码力榜', 'China Open Source HeroRank')}</a>
    <button class="navbar-toggler" type="button" aria-controls="navbarMenu" aria-expanded="false" aria-label="Toggle navigation">
      <svg viewBox="0 0 30 30" fill="none" aria-hidden="true">
        <path stroke="currentColor" stroke-linecap="round" stroke-miterlimit="10" stroke-width="2" d="M4 7h22M4 15h22M4 23h22"></path>
      </svg>
    </button>
    <div class="navbar-menu" id="navbarMenu">
      <ul class="navbar-nav">
        <li class="nav-item">
          <a href={`${home}#ranking`} class="nav-link">{t(locale, '榜单背景', 'Background')}</a>
        </li>
        <li class="nav-item">
          <a href={`${home}#standard`} class="nav-link">{t(locale, '评选标准', 'Criteria')}</a>
        </li>
        <li class="nav-item">
          <a href={`${home}#detail`} class="nav-link">{t(locale, '榜单详情', 'Rankings')}</a>
        </li>
        <li class="nav-item">
          <a href={`${home}#partner`} class="nav-link">{t(locale, '合作伙伴', 'Partners')}</a>
        </li>
        <li class="nav-item">
          <a href="https://github.com/opensourcewin" target="_blank" class="nav-link">GitHub</a>
        </li>
        <li class="nav-item nav-dropdown">
          <button type="button" class="nav-link dropdown-toggle" aria-expanded="false">{t(locale, '往年榜单', 'Past Rankings')}</button>
          <ul class="dropdown-menu">
            {pastYears.map((year) => (
              <li><a class="dropdown-item" href={localePath(locale, `${BASE}/ranking-${year}/`)}>{year}</a></li>
            ))}
          </ul>
        </li>
        <li class="nav-item">
          <a href={mainSite} class="nav-link">{t(locale, '回到官网', 'Main Site')}</a>
        </li>
        {/* 语言切换：跳转到当前页面对应的其他语言 URL，并记录 localStorage('osw-language') */}
        <li class="nav-item lang-switch" aria-label="Language / 语言">
          {LOCALES.map((item, i) => (
            <>
              {i > 0 && <span class="lang-sep" aria-hidden="true">/</span>}
              <a
                class:list={['lang-btn', { active: item === locale }]}
                href={localePath(item, path)}
                hreflang={item}
                rel="alternate"
                aria-current={item === locale ? 'true' : undefined}
                onclick={`try{window.localStorage.setItem('osw-language','${item}')}catch(e){}`}
              >{LANG_LABELS[item]}</a>
            </>
          ))}
        </li>
      </ul>
    </div>
  </div>
</nav>
