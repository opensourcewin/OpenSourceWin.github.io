---
/**
 * 官网首页主体 —— URL 级三语言（en 无前缀 / zh-CN / zh-TW）共用渲染器。
 * 文案来源为 manifesto.ts 的 en / zh 双语数据；zh-TW 由 zh 经 OpenCC 在构建期转换。
 */
import { manifestoContent } from "../data/manifesto";
import Typewriter from "./Typewriter.tsx";
import SeoHead from "@opensource-win/ui/SeoHead.astro";
import FooterCredit from "@opensource-win/ui/FooterCredit.astro";
import LangRedirect from "@opensource-win/ui/LangRedirect.astro";
import { LOCALES, localePath, localeUrl, t, toZhTwDeep, type Locale } from "@opensource-win/ui";
import "../styles/global.css";

import heroImg from "../assets/hero_network.jpg";
import boxImg from "../assets/breaking_black_box.jpg";
import handImg from "../assets/human_ai_symbiosis.jpg";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { meta } = manifestoContent;

// 当前语言的整页文案树：zh-TW 由简体树整体转换
const c = locale === "en" ? manifestoContent.en : locale === "zh-CN" ? manifestoContent.zh : toZhTwDeep(manifestoContent.zh);

const SITE = "https://opensource.win";

const pageTitle = t(locale, meta.pageTitle.zh, meta.pageTitle.en);
const pageDescription = t(locale, meta.pageDescription.zh, meta.pageDescription.en);
const author = t(locale, meta.author.zh, meta.author.en);
const footerTagline = t(locale, meta.footerTagline.zh, meta.footerTagline.en);
const navHeroes = t(locale, meta.navHeroes.zh, meta.navHeroes.en);
const shareText = t(locale, meta.shareText.zh, meta.shareText.en);
const dateText = t(locale, meta.date.zh, meta.date.en);
const roles = meta.roles.map((role) => ({ url: role.url, text: t(locale, role.zh, role.en) }));

const heroesUrl = localeUrl(SITE, locale, "/heroes/");
const shareUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}&hashtags=OpenSourceWin`;
const xUrl = locale === "en" ? "https://x.com/sunnyygao" : "https://x.com/gaoyangio";

const LANG_LABELS: Record<Locale, string> = { en: "EN", "zh-CN": "简", "zh-TW": "繁" };
const langLinks = LOCALES.map((item) => ({
  locale: item,
  href: localePath(item, "/"),
  label: LANG_LABELS[item],
}));

/** Escape a string for safe interpolation into generated attribute HTML. */
function escapeHtml(value: string): string {
  return value
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;");
}

/** Turn `**bold**` segments into <strong> elements. */
function boldHtml(text: string): string {
  return text
    .split("**")
    .map((part, i) =>
      i % 2 === 1
        ? `<strong class="text-foreground font-bold">${escapeHtml(part)}</strong>`
        : escapeHtml(part),
    )
    .join("");
}

/** Turn `[text](url)` links and `**bold**` segments into HTML. */
function inlineHtml(text: string): string {
  return text
    .split(/(\[[^\]]+\]\([^)]+\))/g)
    .map((part) => {
      const link = part.match(/^\[([^\]]+)\]\(([^)]+)\)$/);
      if (link) {
        return `<a href="${escapeHtml(link[2])}" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">${boldHtml(link[1])}</a>`;
      }
      return boldHtml(part);
    })
    .join("");
}

const publishDate = "2026-01-01";
const canonical = localeUrl(SITE, locale, "/");
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: "OpenSource.Win",
      url: SITE,
      description: pageDescription,
      inLanguage: [locale],
      publisher: { "@type": "Organization", name: "OpenSource.Win", url: SITE },
    },
    {
      "@type": "Article",
      headline: pageTitle,
      description: pageDescription,
      image: `${SITE}/og-image.jpg`,
      inLanguage: locale,
      datePublished: publishDate,
      dateModified: publishDate,
      author: {
        "@type": "Person",
        name: "Sunny Gao",
        alternateName: "高阳",
        url: "https://sunshineg.github.io/",
        jobTitle: "Founder & CEO, MindMux.ai",
        sameAs: [
          "https://github.com/sunshineg",
          "https://www.linkedin.com/in/sunnygao/",
          "https://x.com/sunnyygao",
        ],
        affiliation: {
          "@type": "Organization",
          name: "MindMux.ai",
          url: "https://mindmux.ai/",
        },
      },
      publisher: {
        "@type": "Organization",
        name: "OpenSource.Win",
        url: SITE,
        logo: { "@type": "ImageObject", url: `${SITE}/og-image.jpg` },
      },
      mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
    },
  ],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    {/* 首次访问语言重定向：仅英文（无前缀）页面内联，尽早执行避免闪烁（详见共享组件说明） */}
    {locale === "en" && <LangRedirect />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@100..800&display=swap" rel="stylesheet" />

    <!-- Static SEO: title / description / OG / Twitter / canonical / hreflang / JSON-LD baked at build via shared <SeoHead>. -->
    <SeoHead
      seo={{
        title: pageTitle,
        description: pageDescription,
        keywords: "Open Source, AI, Manifesto, Artificial Intelligence, Future, Human-AI Symbiosis, SegmentFault, Apache Answer",
        ogType: "website",
        ogImage: `${SITE}/og-image.jpg`,
        canonical,
        jsonLd,
      }}
      locale={locale}
      path="/"
      siteName="OpenSource.Win"
      author={author}
    />
    <link rel="sitemap" href="/sitemap.xml" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22><rect width=%2264%22 height=%2264%22 fill=%22%230d0d0d%22/><text x=%2232%22 y=%2243%22 font-family=%22monospace%22 font-size=%2230%22 font-weight=%22700%22 fill=%22%234bf08e%22 text-anchor=%22middle%22>%26gt;_</text></svg>" />
  </head>
  <body class="bg-background text-foreground font-mono">
    <div class="min-h-screen font-mono selection:bg-primary selection:text-black">
      <!-- Navbar -->
      <nav class="fixed top-0 left-0 right-0 z-50 border-b border-border bg-background/80 backdrop-blur-sm">
        <div class="container mx-auto px-4 h-16 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <svg aria-hidden="true" class="h-6 w-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5" /><line x1="12" x2="20" y1="19" y2="19" /></svg>
            <span class="font-bold text-lg tracking-tight">OpenSource<span class="text-primary">.Win</span></span>
          </div>

          <div class="flex items-center gap-4">
            {/* 语言切换：跳转到当前页面对应的其他语言 URL，并记录 localStorage('osw-language') */}
            <div class="inline-flex items-center font-mono text-sm" aria-label="Language / 语言">
              {langLinks.map((item, i) => (
                <>
                  {i > 0 && <span class="text-muted-foreground" aria-hidden="true">/</span>}
                  <a
                    href={item.href}
                    hreflang={item.locale}
                    rel="alternate"
                    aria-current={item.locale === locale ? "true" : undefined}
                    onclick={`try{window.localStorage.setItem('osw-language','${item.locale}')}catch(e){}`}
                    class:list={[
                      "px-2 py-2 transition-colors",
                      item.locale === locale ? "text-primary" : "text-muted-foreground hover:text-primary",
                    ]}
                  >{item.label}</a>
                </>
              ))}
            </div>

            <a href={heroesUrl} class="inline-flex items-center justify-center border bg-background text-sm px-4 py-2 font-mono text-foreground hover:bg-accent hover:text-accent-foreground transition-colors hidden sm:inline-flex">
              {navHeroes}
            </a>
          </div>
        </div>
      </nav>

      <!-- Hero Section -->
      <header class="relative min-h-[90vh] flex flex-col items-center justify-center px-8 py-24 overflow-hidden border-b border-border">
        <div class="absolute inset-0 z-0">
          <img src={heroImg.src} alt="Open Source Network" width={1376} height={768} class="w-full h-full object-cover opacity-30 mix-blend-screen" />
          <div class="absolute inset-0 bg-gradient-to-b from-background/90 via-background/50 to-background/90"></div>
          <div class="absolute inset-0 bg-[url('/grid.svg')] opacity-10"></div>
        </div>

        <div class="relative z-10 max-w-4xl w-full space-y-8 text-center sm:text-left">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-primary/20 bg-primary/5 text-primary text-xs tracking-widest uppercase">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
            </span>
            System Broadcast
          </div>

          <h1 class="text-3xl sm:text-4xl md:text-6xl lg:text-7xl font-bold tracking-tighter leading-tight">
            <span class="text-primary block mb-2 text-xl sm:text-2xl md:text-3xl opacity-80 font-normal">./manifesto --init</span>
            {c.title.map((line, i) => (
              <span class={i === 0 ? "block text-primary mb-1" : "block"}>{line}</span>
            ))}
          </h1>

          <p class="text-xl md:text-2xl text-muted-foreground max-w-2xl border-l-2 border-primary/50 pl-6 italic">
            {c.subtitle}
          </p>

          <div class="pt-8 flex flex-col sm:flex-row gap-4">
            <a href="#manifesto" class="inline-flex items-center justify-center gap-2 bg-primary text-primary-foreground hover:bg-primary/90 text-lg h-14 px-8 rounded-none border border-transparent hover:border-primary/50 transition-all font-medium">
              {t(locale, "阅读宣言", "Read Manifesto")}
              <svg aria-hidden="true" class="ml-2 h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
            </a>
          </div>
        </div>
      </header>

      <!-- Intro Section -->
      <section id="manifesto" class="py-24 px-6 border-b border-border bg-card/30 relative scroll-mt-16">
        <div class="max-w-4xl mx-auto grid md:grid-cols-2 gap-12 items-center">
          <div class="space-y-6 text-lg leading-relaxed">
            <p class="font-bold text-2xl text-foreground/90">{c.intro.bold}</p>
            {c.intro.text.map((p) => (
              <p class="text-muted-foreground" set:html={inlineHtml(p)} />
            ))}
            <div class="text-3xl font-bold text-primary pt-4 tracking-tight">
              <Typewriter client:load text={c.intro.highlight} speed={50} startDelay={1000} />
            </div>
          </div>
          <div class="relative group perspective-1000">
            <div class="absolute -inset-1 bg-gradient-to-r from-primary to-secondary rounded-lg blur opacity-25 group-hover:opacity-50 transition duration-1000 group-hover:duration-200"></div>
            <div class="relative aspect-square overflow-hidden border border-border bg-black">
              <img src={boxImg.src} alt="Breaking Black Box" width={1024} height={1024} loading="lazy" class="w-full h-full object-cover opacity-80 hover:scale-105 transition-transform duration-700" />
              <div class="absolute bottom-4 left-4 right-4 bg-black/80 backdrop-blur border border-primary/20 p-3 text-xs text-primary font-mono">
                <div class="flex justify-between mb-1">
                  <span>STATUS:</span>
                  <span>DECRYPTING...</span>
                </div>
                <div class="h-1 bg-primary/20 w-full overflow-hidden">
                  <div class="h-full bg-primary w-[65%] animate-pulse"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Main Content Sections -->
      <main class="max-w-5xl mx-auto py-24 px-6 space-y-32">
        {c.sections.map((section, idx) => (
          <section class="relative">
            <div class="absolute -left-12 top-0 text-9xl font-bold text-border/10 select-none -z-10">0{idx + 1}</div>

            <h2 class="text-4xl font-bold mb-12 flex items-center">
              <span class="text-primary mr-4 text-2xl">#</span>
              <span>{section.title}</span>
            </h2>

            {section.intro && (
              <p class="text-xl text-foreground/80 mb-12 max-w-3xl" set:html={boldHtml(section.intro)} />
            )}

            <div class="grid gap-12">
              {section.items?.map((item) => (
                <div class="group grid md:grid-cols-[1fr_3fr] gap-6 p-6 border border-border/50 hover:border-primary/50 transition-colors bg-card/20 hover:bg-card/40">
                  <div class="space-y-2">
                    {"heading" in item && item.heading && (
                      <h3 class="text-xl font-bold text-primary group-hover:text-primary/80 transition-colors">
                        {item.heading}
                      </h3>
                    )}
                    {"target" in item && item.target && (
                      <h3 class="text-xl font-bold text-secondary-foreground group-hover:text-primary transition-colors">
                        <span>&gt; </span>
                        <span>{item.target}</span>
                      </h3>
                    )}
                    {"id" in item && item.id && <span class="text-xs text-muted-foreground font-mono">ID: {item.id}</span>}
                  </div>
                  <div class="text-muted-foreground leading-relaxed whitespace-pre-wrap">{item.content}</div>
                </div>
              ))}
            </div>

            {idx === 0 && (
              <div class="mt-24 relative h-64 md:h-96 w-full overflow-hidden border-y border-border group">
                <img src={handImg.src} alt="Human AI Symbiosis" width={1376} height={768} loading="lazy" class="w-full h-full object-cover opacity-40 group-hover:opacity-60 transition-opacity duration-700" />
                <div class="absolute inset-0 bg-gradient-to-r from-background via-transparent to-background"></div>
                <div class="absolute inset-0 flex items-center justify-center">
                  <div class="bg-black/80 border border-primary px-6 py-2 text-primary tracking-widest uppercase text-sm backdrop-blur-md">
                    System Architecture: Symbiosis
                  </div>
                </div>
              </div>
            )}

            {"slogan" in section && section.slogan && (
              <div class="mt-12 text-center space-y-8 py-12 bg-primary/5">
                <div class="text-4xl md:text-6xl font-bold text-primary animate-pulse">{section.slogan}</div>
                <div class="space-y-4">
                  {"content" in section && section.content?.map((line) => (
                    <p class="text-xl text-foreground/80">{line}</p>
                  ))}
                </div>
                <div class="pt-4">
                  <a href={shareUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 bg-primary text-primary-foreground hover:bg-primary/90 text-lg h-14 px-8 rounded-none border border-transparent hover:border-primary/50 transition-all font-medium">
                    {t(locale, "支持我们", "Support Us")}
                  </a>
                </div>
              </div>
            )}
          </section>
        ))}
      </main>

      <!-- Footer -->
      <footer class="border-t border-border bg-card py-16 px-6">
        <div class="max-w-4xl mx-auto flex flex-col md:flex-row justify-between items-start md:items-center gap-8">
          <div class="space-y-2">
            <div class="text-2xl font-bold flex items-center gap-2">
              <svg aria-hidden="true" class="text-primary h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5" /><line x1="12" x2="20" y1="19" y2="19" /></svg>
              OpenSource.Win
            </div>
            <p class="text-muted-foreground text-sm max-w-xs">{footerTagline}</p>
          </div>

          <div class="text-right space-y-1 self-end md:self-center">
            <p class="font-bold text-foreground">
              <a href="https://sunshineg.github.io/" target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors">
                {author}
              </a>
            </p>
            {roles.map((role) =>
              role.url ? (
                <p class="text-sm text-muted-foreground">
                  <a href={role.url} target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors">
                    {role.text}
                  </a>
                </p>
              ) : (
                <p class="text-sm text-muted-foreground">
                  {role.text}
                </p>
              ),
            )}
            <p class="text-xs text-primary/60 mt-4 font-mono">{dateText}</p>

            <div class="flex items-center justify-end gap-4 mt-4 pt-2">
              <a href="https://github.com/sunshineg" target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-primary transition-colors" title="GitHub" aria-label="GitHub">
                <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" /><path d="M9 18c-4.51 2-5-2-7-2" /></svg>
                <span class="sr-only">GitHub</span>
              </a>
              <a href="https://www.linkedin.com/in/sunnygao/" target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-primary transition-colors" title="LinkedIn" aria-label="LinkedIn">
                <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" /><rect width="4" height="12" x="2" y="9" /><circle cx="4" cy="4" r="2" /></svg>
                <span class="sr-only">LinkedIn</span>
              </a>
              <a href={xUrl} target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-primary transition-colors" title="X (Twitter)" aria-label="X (Twitter)">
                <svg aria-hidden="true" role="img" class="h-4 w-4" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="currentColor"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z" /></svg>
                <span class="sr-only">X</span>
              </a>
            </div>
          </div>
        </div>
        <FooterCredit class="max-w-4xl mx-auto mt-12 text-center text-xs text-muted-foreground" linkClass="text-primary hover:underline" />
      </footer>
    </div>
  </body>
</html>
