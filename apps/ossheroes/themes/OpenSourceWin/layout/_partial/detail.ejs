<!-- 头部（banner 大图已移除，图片文件仍保留在 source/img/） -->
<div class="header header-detail">
    <%- partial('menu') %>
</div>

<!-- 终端风页面头部：纯 HTML/CSS 装饰（grid 背景 + 辉光 + 扫描线），零图片素材 -->
<div class="detail-hero">
    <div class="detail-hero-scan" aria-hidden="true"></div>
    <div class="detail-hero-inner container">
        <div class="detail-hero-cmd"><span class="detail-term-prompt" aria-hidden="true">$</span> ./whois <%- item.slug %></div>
        <div class="detail-hero-title" aria-hidden="true">&gt; DEVELOPER PROFILE<span class="detail-hero-cursor"></span></div>
        <div class="detail-hero-meta">
            <span class="hero-dot" aria-hidden="true"><span class="hero-dot-ping"></span><span class="hero-dot-core"></span></span>
            <span data-i18n-zh="码力榜开发者档案" data-i18n-en="HeroRank Developer Profile">码力榜开发者档案</span>
        </div>
    </div>
</div>

<!-- 详情 -->
<div class="container detail-content">
    <div class="row justify-content-center">
        <div class="col-sm-12 col-md-8">
            <!-- 终端风 profile 卡片：$ ./whois <login> -->
            <div class="detail-term">
                <div class="detail-term-bar">
                    <span class="detail-term-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                    <span class="detail-term-title">opensource@win: ~</span>
                </div>
                <div class="detail-term-body">
                    <div class="detail-term-cmd"><span class="detail-term-prompt" aria-hidden="true">$</span> ./whois <%- item.slug %></div>
                    <%
                        const years = site.data.rankingList?.sort((a,b)=>b.year - a.year).flatMap(({ year, annualRanking }) =>
                          annualRanking
                            .filter(({ login }) => login == item.slug)
                            .map(({ ranking }) => ({ year, ranking }))
                        );
                    %>
                    <div class="detail-term-result">
                        <%- partial('avatar', {className: 'detail-avatar', item: item}) %>
                        <div class="detail-term-info">
                            <div class="detail-term-line">
                                <span class="detail-term-out" aria-hidden="true">&gt;</span>
                                <span class="detail-term-key" data-i18n-zh="名称" data-i18n-en="name">名称</span>
                                <span class="detail-term-sep" aria-hidden="true">::</span>
                                <span class="detail-term-name"><%- item.name ? item.name : item.slug %></span>
                            </div>
                            <div class="detail-term-line">
                                <span class="detail-term-out" aria-hidden="true">&gt;</span>
                                <span class="detail-term-key" data-i18n-zh="所在地" data-i18n-en="location">所在地</span>
                                <span class="detail-term-sep" aria-hidden="true">::</span>
                                <span class="text-secondary"><%- item.description %></span>
                            </div>
                            <div class="detail-term-line">
                                <span class="detail-term-out" aria-hidden="true">&gt;</span>
                                <span class="detail-term-key">github</span>
                                <span class="detail-term-sep" aria-hidden="true">::</span>
                                <%- link_to('https://github.com/' + item.slug, '@' + item.slug, {external: true}) %>
                            </div>
                            <% if(years.length) { %>
                                <div class="detail-ranks">
                                    <%- partial('_partial/ranking', {years: years}) %>
                                </div>
                            <% } %>
                        </div>
                    </div>
                    <!-- osgraph 嵌入已失效（对方证书过期），改为外链访问 -->
                    <div class="detail-term-graphs">
                        <span class="detail-term-prompt" aria-hidden="true">$</span>
                        <span class="detail-graphs-cmd">open ./graphs</span>
                        <span class="detail-graphs-arrow" aria-hidden="true">-&gt;</span>
                        <span class="detail-graphs-links">
                            <a class="detail-graph-link" href="https://osgraph.com/graphs/developer-activity/github/<%= item.slug %>?user-limit=10" target="_blank" rel="noopener" data-i18n-zh="开发活动" data-i18n-en="Developer Activity">开发活动</a>
                            <a class="detail-graph-link" href="https://osgraph.com/graphs/os-partner/github/<%= item.slug %>?user-limit=10" target="_blank" rel="noopener" data-i18n-zh="开源伙伴" data-i18n-en="Open Source Partners">开源伙伴</a>
                            <a class="detail-graph-link" href="https://osgraph.com/graphs/os-interest/github/<%= item.slug %>?repo-limit=5&amp;topic-limit=3" target="_blank" rel="noopener" data-i18n-zh="开源兴趣" data-i18n-en="Open Source Interests">开源兴趣</a>
                        </span>
                    </div>
                </div>
            </div>

            <div class="detail-divider" aria-hidden="true">---</div>

            <!-- GitHub Profile README：客户端拉取 <login>/<login> 仓库 README，失败整体隐藏 -->
            <div class="detail-term detail-readme" id="detailReadme" data-login="<%- item.slug %>" hidden>
                <div class="detail-term-bar">
                    <span class="detail-term-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                    <span class="detail-term-title">~/profile/README.md</span>
                </div>
                <div class="detail-term-body">
                    <div class="detail-term-cmd"><span class="detail-term-prompt" aria-hidden="true">$</span> cat ~/profile/README.md</div>
                    <div class="detail-readme-body" id="detailReadmeContent"></div>
                    <div class="detail-readme-src">
                        <span class="detail-term-out" aria-hidden="true">&gt;</span>
                        <span data-i18n-zh="来源" data-i18n-en="source">来源</span>
                        <span class="detail-term-sep" aria-hidden="true">::</span>
                        <a href="https://github.com/<%= item.slug %>/<%= item.slug %>" target="_blank" rel="noopener">github.com/<%- item.slug %>/<%- item.slug %></a>
                    </div>
                </div>
            </div>

            <%
                // 从 item.content 提取 github.com/owner/repo 链接，重构为终端风列表
                // 仅认 <li> 列表项中的仓库链接；正文其余部分（简介、段落）原样保留
                // 富内容页（图片 / 多级标题 / 表格等，如 huan）整体回退渲染原始 item.content
                const contentStr = item.content || '';
                const isRichContent = /<(img|h2|h4|h5|h6|table|center|figure|video)\b/i.test(contentStr);
                const repoLinkRe = /href="https?:\/\/github\.com\/([A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)\/([A-Za-z0-9_.-]+?)\/?"/;
                const repos = [];
                let proseHtml = '';
                if (!isRichContent) {
                    const seenRepos = {};
                    const liRe = /<li>([\s\S]*?)<\/li>/g;
                    let liMatch;
                    while ((liMatch = liRe.exec(contentStr)) !== null) {
                        const linkMatch = liMatch[1].match(repoLinkRe);
                        if (!linkMatch) continue;
                        const dedupeKey = (linkMatch[1] + '/' + linkMatch[2]).toLowerCase();
                        if (seenRepos[dedupeKey]) continue;
                        seenRepos[dedupeKey] = true;
                        // 列表项里链接之后的文字视为一句话简介（去标签、截断）
                        let desc = liMatch[1]
                            .replace(/<a [^>]*>[\s\S]*?<\/a>/, '')
                            .replace(/<[^>]+>/g, '')
                            .replace(/^[\s\-–—:：]+/, '')
                            .trim();
                        if (desc.length > 120) desc = desc.slice(0, 120).replace(/&[^;]*$/, '') + ' …';
                        repos.push({ owner: linkMatch[1], name: linkMatch[2], desc: desc });
                    }
                    if (repos.length) {
                        // 正文保留：去掉「主要贡献项目」标题与含仓库链接的列表，其余原样渲染
                        proseHtml = contentStr
                            .replace(/<h3[^>]*>[\s\S]*?主要贡献项目[\s\S]*?<\/h3>/, '')
                            .replace(/<ul[^>]*>[\s\S]*?<\/ul>/g, (ul) => repoLinkRe.test(ul) ? '' : ul)
                            .trim();
                    }
                }
            %>
            <div class="contribute">
                <% if (repos.length) { %>
                    <% if (proseHtml) { %>
                        <div class="contribute-prose"><%- proseHtml %></div>
                    <% } %>
                    <h2 class="detail-section-title" data-i18n-zh="主要贡献项目" data-i18n-en="Top Contributions">主要贡献项目</h2>
                    <div class="detail-term detail-repos">
                        <div class="detail-term-bar">
                            <span class="detail-term-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                            <span class="detail-term-title">~/contributions</span>
                            <span class="detail-repos-count"><%= repos.length %> <span data-i18n-zh="个仓库" data-i18n-en="repos">个仓库</span></span>
                        </div>
                        <div class="detail-term-body">
                            <div class="detail-term-cmd"><span class="detail-term-prompt" aria-hidden="true">$</span> ls -la ~/contributions</div>
                            <ul class="detail-repos-list">
                                <% repos.forEach(({ owner, name, desc }) => { %>
                                    <li class="detail-repos-row">
                                        <a href="https://github.com/<%= owner %>/<%= name %>" target="_blank" rel="noopener">
                                            <span class="detail-repos-perm" aria-hidden="true">-rw-r--r--</span>
                                            <span class="detail-repos-main">
                                                <span class="detail-repos-name"><%- owner %>/<%- name %></span>
                                                <% if (desc) { %>
                                                    <span class="detail-repos-desc"><%- desc %></span>
                                                <% } %>
                                            </span>
                                            <span class="detail-repos-arrow" aria-hidden="true">-&gt;</span>
                                        </a>
                                    </li>
                                <% }) %>
                            </ul>
                        </div>
                    </div>
                <% } else if (contentStr.trim()) { %>
                    <%- item.content %>
                <% } %>
            </div>
        </div>
    </div>
</div>

<%- partial('_partial/copyRight') %>
