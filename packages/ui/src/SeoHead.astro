---
/**
 * 共享 SEO <head> 渲染器 —— apps/www 与 apps/ossheroes 复用同一套标准 meta：
 * title / description / keywords / author / OG / Twitter / canonical / theme-color / JSON-LD。
 *
 * URL 级三语言（en 无前缀 + /zh-CN/ + /zh-TW/）下额外负责：
 * - canonical 自指当前语言版本（调用方按 locale 构造 seo.canonical）；
 * - 4 条 <link rel="alternate" hreflang>（en / zh-CN / zh-TW / x-default→en），
 *   由 locale 中立的 path 推导；
 * - og:locale 与另外两种语言的 og:locale:alternate。
 *
 * 站点级信息（siteName / author / themeColor / twitterSite / keywordsFallback / robots）
 * 由各 app 按自身情况传入；各 app 专属的 <meta name="generator"> / sitemap / favicon /
 * 字体预连接仍留在各自页面。
 */
import type { PageSeo, Locale } from './index';
import { stringifyJsonLd } from './seo';
import { hreflangAlternates, LOCALES, OG_LOCALE } from './i18n';

interface Props {
  seo: PageSeo;
  /** 当前页面语言 */
  locale: Locale;
  /** locale 中立的规范路径（如 '/'、'/heroes/'、'/hero/<login>/'），用于推导 hreflang */
  path: string;
  siteUrl?: string;
  siteName?: string;
  author?: string;
  themeColor?: string;
  twitterSite?: string;
  keywordsFallback?: string;
  robots?: string;
}

const {
  seo,
  locale,
  path,
  siteUrl = 'https://opensource.win',
  siteName,
  author,
  themeColor = '#0d0d0d',
  twitterSite,
  keywordsFallback,
  robots,
} = Astro.props;

const keywords = seo.keywords ?? keywordsFallback;
const alternates = hreflangAlternates(siteUrl, path);
const ogLocaleAlternates = LOCALES.filter((item) => item !== locale);
---

{robots && <meta name="robots" content={robots} />}
<title>{seo.title}</title>
{seo.description && <meta name="description" content={seo.description} />}
{keywords && <meta name="keywords" content={keywords} />}
{author && <meta name="author" content={author} />}

<!-- Open Graph -->
<meta property="og:title" content={seo.title} />
{seo.description && <meta property="og:description" content={seo.description} />}
<meta property="og:type" content={seo.ogType} />
<meta property="og:url" content={seo.canonical} />
<meta property="og:image" content={seo.ogImage} />
{siteName && <meta property="og:site_name" content={siteName} />}
<meta property="og:locale" content={OG_LOCALE[locale]} />
{ogLocaleAlternates.map((item) => <meta property="og:locale:alternate" content={OG_LOCALE[item]} />)}

<!-- Twitter -->
{twitterSite && <meta name="twitter:site" content={twitterSite} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={seo.title} />
{seo.description && <meta name="twitter:description" content={seo.description} />}
<meta name="twitter:image" content={seo.ogImage} />

{/* Canonical（自指当前语言）+ hreflang（en / zh-CN / zh-TW / x-default） */}
<link rel="canonical" href={seo.canonical} />
{alternates.map((item) => <link rel="alternate" hreflang={item.hreflang} href={item.href} />)}
<meta name="theme-color" content={themeColor} />

{/* 结构化数据：转义 `<` 防止标签提前闭合 */}
{seo.jsonLd && (
  <script type="application/ld+json" is:inline set:html={stringifyJsonLd(seo.jsonLd)} />
)}
