---
import '../styles/global.css';
import SeoHead from '@opensource-win/ui/SeoHead.astro';
import type { PageSeo } from '@opensource-win/ui';
import { BASE, SITE_AUTHOR, SITE_KEYWORDS, SITE_TITLE_ZH } from '../lib/site';

interface Props {
  seo: PageSeo;
}

const { seo } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <SeoHead
    seo={seo}
    siteName={SITE_TITLE_ZH}
    locale="zh_CN"
    author={SITE_AUTHOR}
    twitterSite={SITE_TITLE_ZH}
    keywordsFallback={SITE_KEYWORDS}
  />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@100..800&display=swap"
    rel="stylesheet"
  />
  <link rel="icon" type="image/svg+xml" href={`${BASE}/img/favicon.svg`} />
  <link rel="icon" type="image/x-icon" href={`${BASE}/img/favicon.ico`} />
</head>
<body>
  <slot />
  <script>
    import '../scripts/i18n';
    import '../scripts/nav';
  </script>
</body>
</html>
