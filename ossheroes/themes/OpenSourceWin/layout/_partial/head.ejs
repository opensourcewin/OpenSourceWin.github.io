<head>

    <meta charset="utf-8"/>
    <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>

    <!-- Title -->
    <%
    var title = [];
    if (page.name) {
        title.push(page.name);
    } else if (page.slug) {
        title.push(page.slug);
    }
    title.push(config.title);
    %>
    <title><%= title.join(' - ') %></title>

    <!--Description-->

    <%
    var description = '';
    if (page.description) {
        description = page.description;
    } else if (config.description) {
        description = config.description;
    } else if (page.excerpt) {
        description = strip_html(page.excerpt).replace(/^\s*/, '').replace(/\s*$/, '');
    } else if (page.content) {
        description = strip_html(page.content).replace(/^\s*/, '').replace(/\s*$/, '').substring(0, 150);
    }
    %>

    <% if (description) { %>
        <meta name="description" content="<%= description %>"/>
    <% } %>

    <!--Keywords-->
    <% if (config.keywords) { %>
        <meta name="keywords" content="<%= Array.isArray(config.keywords) ? config.keywords.join(',') : config.keywords %>"/>
    <% } %>

    <!--Author-->
    <% if (config.author) { %>
        <meta name="author" content="<%= config.author %>"/>
    <% } %>

    <!--Open Graph Title-->
    <meta property="og:title" content="<%= title.join(' - ') %>" />

    <!--Open Graph Description-->
    <% if (description) { %>
        <meta property="og:description" content="<%= description %>"/>
    <% } %>

    <!--Open Graph Site Name-->
        <meta property="og:site_name" content="<%= config.title %>"/>

    <!--Open Graph URL / Locale / Image-->
        <meta property="og:url" content="<%- full_url_for(page.path || '') %>"/>
        <meta property="og:locale" content="<%= (config.language || 'zh-CN').replace('-', '_') %>"/>
        <meta property="og:image" content="https://opensource.win/ossheroes/img/banner-index-new.png"/>

    <!--Canonical / Theme Color-->
        <link rel="canonical" href="<%- full_url_for(page.path || '') %>"/>
        <meta name="theme-color" content="#0d0d0d"/>

    <!--Type page-->
    <% if(title.length > 1) { %>
        <meta property="og:type" content="article"/>
    <% } else { %>
        <meta property="og:type" content="website"/>
    <% } %>

    <meta name="twitter:site" content="<%= config.title %>">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= title.join(' - ') %>">
    <% if (description) { %>
        <meta name="twitter:description" content="<%= description %>">
    <% } %>
    <meta name="twitter:image" content="https://opensource.win/ossheroes/img/banner-index-new.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@100..800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p" crossorigin="anonymous"></script>
    <link rel="icon" type="image/svg+xml" href="<%- url_for('img/favicon.svg') %>">
    <%- favicon_tag('img/favicon.ico') %>
    <%- css('css/index.v1.css') %>
    <%- js('js/i18n.js') %>
    <%# 开发者详情页（page.ejs 且无 data_year）才渲染 README 模块：marked 与 DOMPurify 必须先于 detail-readme.js 加载 %>
    <% if (is_page() && !page.data_year) { %>
        <%- js('js/vendor/marked.min.js') %>
        <%- js('js/vendor/purify.min.js') %>
    <% } %>
    <%- js('js/detail-readme.js') %>
</head>
