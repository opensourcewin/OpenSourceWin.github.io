---
import "../styles/global.css";
const SITE = "https://opensource.win/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@100..800&display=swap" rel="stylesheet" />
    <title>404 — OpenSource.Win</title>
    <meta name="robots" content="noindex,follow" />
    <meta name="theme-color" content="#0d0d0d" />
    <link rel="canonical" href={`${SITE}404.html`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-background text-foreground font-mono">
    <div class="min-h-screen flex flex-col items-center justify-center p-8">
      <h1 class="text-6xl font-bold mb-4 text-primary">404</h1>
      <p class="text-muted-foreground mb-8">Page not found</p>
      <a href="/" class="inline-flex items-center justify-center bg-primary text-primary-foreground hover:bg-primary/90 text-base h-10 px-6 rounded-none border border-transparent transition-all font-medium">
        Go Home
      </a>
      <div class="mt-16 text-center text-xs text-muted-foreground">
        Built With{' '}
        <a href="https://mindmux.ai/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
          MindMux
        </a>
      </div>
    </div>
  </body>
</html>