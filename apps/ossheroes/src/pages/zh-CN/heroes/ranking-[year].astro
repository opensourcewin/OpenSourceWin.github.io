---
import RankingPage from '../../../components/pages/RankingPage.astro';
import { getYearsDesc } from '../../../lib/ranking';

export function getStaticPaths() {
  return getYearsDesc().map((item) => ({
    params: { year: String(item.year) },
    props: { year: item.year },
  }));
}

const { year } = Astro.props;
---

<RankingPage locale="zh-CN" year={year} />
